# .env.example
# Copy to .env and fill in real values. Keeps secrets out of docker-compose.yml
# and out of version control.

# --- Database ---
DATABASE_URL=postgresql://adw:adw_password@postgres:5432/adw_db

# --- Redis / task queue ---
REDIS_URL=redis://redis:6379/0

# --- Vector DB (used only by the optional AI layer) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- Optional AI layer: only needed if AI_LAYER_ENABLED=true ---
AI_LAYER_ENABLED=false
LLM_PROVIDER=openai              # openai | gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000